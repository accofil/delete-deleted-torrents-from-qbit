#!/usr/bin/env bash
set -Eeuo pipefail

QBIT_URL="${QBIT_URL:-http://127.0.0.1:10998}"
CONFIG_FILE="${QBIT_TAG_DELETE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/qbit-tag-delete/config}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/qbit-tag-delete"
SELF="$(readlink -f -- "$0")"

usage() {
  cat <<'USAGE'
Használat:
  qbit-delete-tag            # TAG bekérése, majd futtatás leválasztott tmuxban
  qbit-delete-tag TAG        # megadott TAG, majd futtatás leválasztott tmuxban
  qbit-delete-tag --worker TAG   # belső/hibakeresési mód, tmux nélkül
USAGE
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "HIBA: hiányzó parancs: $1" >&2
    exit 1
  }
}

load_config() {
  if [[ -r "$CONFIG_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
  fi

  QBIT_URL="${QBIT_URL:-http://127.0.0.1:10998}"
  QBIT_URL="${QBIT_URL%/}"
  QBIT_USER="${QBIT_USER:-}"
  QBIT_PASS="${QBIT_PASS:-}"

  if [[ -z "$QBIT_USER" || -z "$QBIT_PASS" ]]; then
    cat >&2 <<EOF_CONFIG
HIBA: nincs beállítva a qBittorrent WebUI felhasználónév/jelszó.
Hozd létre ezt a fájlt:
  $CONFIG_FILE

Tartalma például:
  QBIT_USER='felhasznalo'
  QBIT_PASS='jelszo'

A WebUI alapértelmezett címe ebben a scriptben:
  http://127.0.0.1:10998
EOF_CONFIG
    exit 1
  fi
}

worker() {
  local tag="$1"
  local cookie torrents hashes count remaining login_reply

  need_cmd curl
  need_cmd jq
  load_config

  cookie="$(mktemp)"
  trap 'rm -f -- "$cookie"' EXIT

  echo "WebUI : $QBIT_URL"
  echo "TAG   : $tag"
  echo "Idő   : $(date)"
  echo

  echo "[1/4] Bejelentkezés..."
  login_reply="$(
    curl -fsS \
      --cookie-jar "$cookie" \
      -H "Referer: $QBIT_URL/" \
      --data-urlencode "username=$QBIT_USER" \
      --data-urlencode "password=$QBIT_PASS" \
      "$QBIT_URL/api/v2/auth/login"
  )"
  if [[ "$login_reply" != "Ok." ]]; then
    echo "HIBA: qBittorrent bejelentkezés sikertelen: ${login_reply:-<üres válasz>}" >&2
    exit 1
  fi
  echo "OK"

  echo "[2/4] '$tag' TAG-gel rendelkező torrentek lekérése..."
  torrents="$(
    curl -fsS \
      --cookie "$cookie" \
      -H "Referer: $QBIT_URL/" \
      --get \
      --data-urlencode "tag=$tag" \
      "$QBIT_URL/api/v2/torrents/info"
  )"

  if ! jq -e 'type == "array"' >/dev/null <<<"$torrents"; then
    echo "HIBA: a qBittorrent API nem várt választ adott." >&2
    exit 1
  fi

  count="$(jq 'length' <<<"$torrents")"
  if (( count == 0 )); then
    echo "Nincs '$tag' TAG-gel rendelkező torrent. Nincs mit törölni."
    return 0
  fi

  echo "Találat: $count torrent"
  jq -r '.[] | "  - \(.name) [\(.hash)]"' <<<"$torrents"

  hashes="$(jq -r '.[].hash' <<<"$torrents" | paste -sd'|' -)"
  if [[ -z "$hashes" ]]; then
    echo "HIBA: nem sikerült hash-listát készíteni." >&2
    exit 1
  fi

  echo
  echo "[3/4] Torrentek ÉS a hozzájuk tartozó adatok törlése..."
  curl -fsS \
    --cookie "$cookie" \
    -H "Referer: $QBIT_URL/" \
    --data-urlencode "hashes=$hashes" \
    --data-urlencode "deleteFiles=true" \
    "$QBIT_URL/api/v2/torrents/delete" >/dev/null
  echo "Törlési kérés elküldve deleteFiles=true beállítással."

  echo "[4/4] Ellenőrzés..."
  remaining="$(
    curl -fsS \
      --cookie "$cookie" \
      -H "Referer: $QBIT_URL/" \
      --get \
      --data-urlencode "tag=$tag" \
      "$QBIT_URL/api/v2/torrents/info"
  )"
  if ! jq -e 'type == "array"' >/dev/null <<<"$remaining"; then
    echo "HIBA: az ellenőrző API-hívás nem várt választ adott." >&2
    exit 1
  fi

  if (( $(jq 'length' <<<"$remaining") == 0 )); then
    echo "KÉSZ: a '$tag' TAG torrentjei törölve lettek a qBittorrentből az adataikkal együtt."
  else
    echo "FIGYELEM: néhány '$tag' TAG-gel rendelkező torrent még látszik:" >&2
    jq -r '.[] | "  - \(.name) [\(.hash)]"' <<<"$remaining" >&2
    exit 2
  fi
}

start_tmux() {
  local tag="$1"
  local stamp safe_tag session log runner

  need_cmd tmux
  mkdir -p "$STATE_DIR"
  chmod 700 "$STATE_DIR" 2>/dev/null || true

  stamp="$(date +%Y%m%d-%H%M%S)"
  safe_tag="$(printf '%s' "$tag" | tr -cs '[:alnum:]_.-' '_')"
  safe_tag="${safe_tag:0:24}"
  session="qbit-delete-${safe_tag:-tag}-$stamp"
  log="$STATE_DIR/qbit-delete-$stamp.log"
  runner="$STATE_DIR/.runner-$stamp-$$.sh"

  {
    echo '#!/usr/bin/env bash'
    echo 'set -o pipefail'
    printf '%q --worker %q 2>&1 | tee -a %q\n' "$SELF" "$tag" "$log"
    echo 'rc=${PIPESTATUS[0]}'
    printf 'rm -f -- %q\n' "$runner"
    echo 'exit "$rc"'
  } >"$runner"
  chmod 700 "$runner"

  tmux new-session -d -s "$session" "$runner"

  echo "Elindítva leválasztott tmux munkamenetben."
  echo "Session: $session"
  echo "Log    : $log"
  echo
  echo "Csatlakozás: tmux attach -t '$session'"
  echo "Log nézés   : tail -f '$log'"
}

main() {
  local tag=""

  case "${1:-}" in
    -h|--help)
      usage
      return 0
      ;;
    --worker)
      [[ $# -eq 2 ]] || { usage >&2; return 2; }
      worker "$2"
      return
      ;;
  esac

  if (( $# > 1 )); then
    usage >&2
    return 2
  fi

  if (( $# == 1 )); then
    tag="$1"
  else
    read -r -p "Törlendő TAG: " tag
  fi

  if [[ -z "${tag//[[:space:]]/}" ]]; then
    echo "HIBA: a TAG nem lehet üres." >&2
    return 2
  fi

  start_tmux "$tag"
}

main "$@"
